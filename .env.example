# =================================================================
# APAYAO STATE COLLEGE - AUTOMATED SCORING & TABULATION SYSTEM (ASC-STS)
# Production MySQL Configuration for Hostinger / cPanel / Localhost
# =================================================================

# 1. MySQL Server Host (typically 'localhost' or '127.0.0.1' on Hostinger cPanel)
MYSQL_HOST="localhost"

# 2. MySQL Server Port (standard MySQL default is 3306)
MYSQL_PORT="3306"

# 3. MySQL Database Name (e.g. u123456789_asts_db on Hostinger hPanel)
MYSQL_DATABASE="asts_db"

# 4. MySQL Database Username (e.g. u123456789_admin on Hostinger)
MYSQL_USER="root"

# 5. MySQL Database User Password
MYSQL_PASSWORD=""

# 6. Optional: Single Connection URL format (if provided by hosting platform)
# DATABASE_URL="mysql://username:password@localhost:3306/asts_db"

# 7. JWT Secret key for session security (change to random 32+ char string in production)
JWT_SECRET="asc_secret_jwt_key_2026_change_in_production"
