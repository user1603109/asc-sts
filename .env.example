# =================================================================
# APAYAO STATE COLLEGE - AUTOMATED SCORING & TABULATION SYSTEM (ASC-STS)
# Environment Variables Configuration for Vercel & Local Development
# =================================================================

# 1. Google Cloud Service Account Email (from your Google Cloud IAM service account key JSON)
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@your-project-id.iam.gserviceaccount.com"

# 2. Google Cloud Service Account Private Key (keep full "-----BEGIN PRIVATE KEY-----\n..." including \n)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# 3. Google Spreadsheet ID (from your Google Sheet URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit)
GOOGLE_SHEET_ID="your_google_spreadsheet_id_here"

# 4. Optional: Google Drive Folder ID to store uploaded contestant photos (uses your 5TB storage)
GOOGLE_DRIVE_FOLDER_ID=""

# 5. JWT Secret key for secure session cookies
JWT_SECRET="asc_secret_jwt_key_2026_change_in_production"

# Note: Remember to SHARE your Google Spreadsheet and Drive Folder with your
# GOOGLE_SERVICE_ACCOUNT_EMAIL as "Editor"!
